<?xml version="1.0" encoding="UTF-8"?>
<!-- The do-while loop of the Simulator's tests/fixtures/bpmn/ciclo_do_while.bpmn
     (Simulator 94d8a252), its process and diagram only: Gw_merge, T2, then
     Gw_check takes f_back to Gw_merge or f_exit through Gw_exit to End. The
     Simulator's extension elements are dropped, as the modeller does not read
     them, and the names are in English. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_ciclo_do_while"
                  targetNamespace="http://example.com/sese">
  <bpmn:process id="P_do_while" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>

    <bpmn:task id="T1">
      <bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gw_merge" name="once more">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f_back</bpmn:incoming>
      <bpmn:outgoing>f_body</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="T2">
      <bpmn:incoming>f_body</bpmn:incoming><bpmn:outgoing>f_dec</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gw_check" name="again?" default="f_exit">
      <bpmn:incoming>f_dec</bpmn:incoming>
      <bpmn:outgoing>f_back</bpmn:outgoing>
      <bpmn:outgoing>f_exit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_exit" name="done">
      <bpmn:incoming>f_exit</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="Gw_merge" />
    <bpmn:sequenceFlow id="f_body" sourceRef="Gw_merge" targetRef="T2" />
    <bpmn:sequenceFlow id="f_dec" sourceRef="T2" targetRef="Gw_check" />
    <bpmn:sequenceFlow id="f_back" sourceRef="Gw_check" targetRef="Gw_merge" name="back" />
    <bpmn:sequenceFlow id="f_exit" sourceRef="Gw_check" targetRef="Gw_exit" />
    <bpmn:sequenceFlow id="f3" sourceRef="Gw_exit" targetRef="End" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_P_do_while">
    <bpmndi:BPMNPlane id="BPMNPlane_P_do_while" bpmnElement="P_do_while">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="42.727" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1">
        <dc:Bounds x="104.545" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_merge_di" bpmnElement="Gw_merge">
        <dc:Bounds x="228.545" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2">
        <dc:Bounds x="302.545" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_check_di" bpmnElement="Gw_check">
        <dc:Bounds x="426.545" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_exit_di" bpmnElement="Gw_exit">
        <dc:Bounds x="500.545" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="575.909" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="78.727" y="118.000" />
        <di:waypoint x="104.545" y="118.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="204.545" y="118.000" />
        <di:waypoint x="228.545" y="120.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_body_di" bpmnElement="f_body">
        <di:waypoint x="278.545" y="120.000" />
        <di:waypoint x="302.545" y="120.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_dec_di" bpmnElement="f_dec">
        <di:waypoint x="402.545" y="120.000" />
        <di:waypoint x="426.545" y="120.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_back_di" bpmnElement="f_back">
        <di:waypoint x="451.545" y="145.000" />
        <di:waypoint x="451.545" y="220.000" />
        <di:waypoint x="253.545" y="220.000" />
        <di:waypoint x="253.545" y="145.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_exit_di" bpmnElement="f_exit">
        <di:waypoint x="476.545" y="120.000" />
        <di:waypoint x="500.545" y="120.000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="550.545" y="120.000" />
        <di:waypoint x="575.909" y="118.000" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
