{
  "name": "bpmn-js-token-simulation",
  "version": "0.40.0",
  "description": "bpmn-js token simulation extension",
  "module": "lib/index.js",
  "main": "lib/index.js",
  "scripts": {
    "all": "run-s bundle:src test bundle",
    "bundle:src": "rollup -c --bundleConfigAsCjs",
    "postinstall": "node ./tasks/ensure-rollup-binary.js",
    "prebundle": "npm run bundle:src",
    "bundle": "webpack --mode production",
    "prebundle:watch": "npm run bundle:src",
    "bundle:watch": "webpack -w",
    "start": "cross-env SINGLE_START=modeler npm run dev",
    "prestart:example": "npm run bundle:src",
    "start:example": "webpack serve --static ./example --open",
    "prestart:basic": "npm run bundle:src",
    "start:basic": "webpack serve --static ./example --open /basic/",
    "lint": "run-s lint:js lint:bpmn",
    "lint:js": "eslint .",
    "lint:bpmn": "bpmnlint \"example/**/*.bpmn\"",
    "pretest": "npm run bundle:src",
    "test": "run-s lint:js lint:bpmn test:unit",
    "test:unit": "karma start",
    "dev": "npm test -- --auto-watch --no-single-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/bpmn-js-token-simulation.git"
  },
  "author": "bpmn.io contributors",
  "contributors": [
    {
      "name": "Patrick Dehn",
      "url": "https://github.com/pedesen"
    },
    {
      "name": "Philipp Fromme",
      "url": "https://github.com/philippfromme"
    },
    {
      "name": "Sebastian Warnke",
      "url": "https://github.com/sebwarnke"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bpmn-io/bpmn-js-token-simulation/issues"
  },
  "homepage": "https://github.com/bpmn-io/bpmn-js-token-simulation#readme",
  "files": [
    "assets",
    "lib",
    "index.js"
  ],
  "engines": {
    "node": ">= 22"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@bpmn-io/add-exporter": "^0.2.0",
    "@bpmn-io/properties-panel": "^3.47.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "bpmn-js": "^18.19.0",
    "bpmn-js-bpmnlint": "^0.23.0",
    "bpmn-js-properties-panel": "^5.60.0",
    "bpmn-to-image": "^0.9.0",
    "bpmnlint": "^11.6.0",
    "bpmnlint-loader": "^0.1.6",
    "chai": "^6.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "downloadjs": "^1.4.7",
    "eslint": "^9.39.4",
    "eslint-plugin-bpmn-io": "^2.3.1",
    "file-drops": "^0.7.0",
    "file-open": "^0.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-coverage": "^2.2.1",
    "karma-debug-launcher": "^0.0.5",
    "karma-env-preprocessor": "^0.1.1",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-tldr-reporter": "^1.0.0",
    "karma-webpack": "^5.0.1",
    "mocha": "^11.7.6",
    "mocha-test-container-support": "^0.2.0",
    "npm-run-all2": "^9.0.2",
    "puppeteer": "^24.31.0",
    "rollup": "^4.62.2",
    "rollup-plugin-string": "^3.0.0",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  },
  "overrides": {
    "puppeteer": "^24.31.0",
    "puppeteer-core": "^24.31.0",
    "@puppeteer/browsers": "^2.10.13",
    "@babel/helpers": "^7.26.10",
    "js-yaml": "^4.1.1",
    "compression": "^1.8.1",
    "on-headers": "^1.1.0",
    "cookie": "^0.7.2",
    "engine.io": "^6.6.2",
    "socket.io": "^4.8.1",
    "socket.io-adapter": "^2.5.5",
    "ws": "^8.18.3",
    "tmp": "^0.2.5",
    "trim-newlines": "^3.0.1",
    "test-exclude": "^7.0.1"
  },
  "dependencies": {
    "@bpmn-io/diagram-js-canvas-lock": "^0.1.0",
    "bpmn-js-color-picker": "^0.7.2",
    "diagram-js-grid": "^1.1.0",
    "diagram-js-minimap": "^5.2.0",
    "heatmap.js": "^2.0.5",
    "ids": "^3.0.2",
    "inherits-browser": "^0.1.0",
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0",
    "randomcolor": "^0.6.2"
  }
}
